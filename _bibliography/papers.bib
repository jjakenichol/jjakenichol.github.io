@techreport{Bull2024CLDERA,
  abbr            = {SNL Report},
  author          = {Diana Bull and Kara Peterson and Lyndsay Shand and Laura Swiler and Irina Tezaur and Ben K. Cook and Andrew Salinger and Clare Amann and Bernadette Watts and Rob Leland and Luca Bertagna and Hunter Brown and Meredith Brown and Mauricio Campos and Max Carlson and Kenny Chowdhary and Joseph Crockett and Warren Davis and Thomas Ehrmann and Robert Garrett and Katherine Goode and Mamikon Gulian and Carole Hall and Graham Harper and Joseph Hart and James Hickey and Benjamin Hillman and Brent Houchens and Jose Gabriel Huerta and Daniel Krofcheck and Justin Li and Indu Manickam and Kellie McClernon and Audrey McCombs and J. Jake Nichol and Matthew Peterson and Daniel Ries and Mark A. Smith and Andrea Staid and Andrew Steyer and James Derek Tucker and Benjamin Wagman and Jerry Watkins and Christopher Wentland and Everett Wenzel and Robert Michael Weylandt and Andrew Yarger},
  title           = {{CLimate Impact: Determining Etiology thRough pAthways (CLDERA)}},
  institution     = {Sandia National Laboratories},
  number          = {SAND2024-13423R},
  address         = {Albuquerque, NM},
  additional_info = {Sandia National Laboratories, Tech. Rep. SAND2024-13423R},
  year            = {2024},
  doi             = {10.2172/2480139},
  abstract        = {Climate impacts have broad economic, health, political, and national security ramifications. Societally relevant impacts are typically farther downstream, are the product of multiple interacting processes, and can arise over small regions and timeframes because their sources are short-term and localized. Short-term forcings (as can be seen in volcanic eruptions, climatic tipping points (e.g., the collapse of rainforests or the disappearance of sea ice), or in increasingly plausible climate interventions) fundamentally possess low signal-to-noise and could benefit from accounting for the multiple conditional processes through which a downstream impact arises. Under the Grand Challenge LDRD CLDERA (CLimate impacts: Discovering Etiology thRough pAthways), we have developed tools to enable downstream impact attribution from geographically and temporally localized source forcings in the climate. CLDERA developed methods that can distinguish how a localized source drives the climate system to respond with particular impacts. The how is embodied in pathways -- the spatio-temporally evolving chain of physical processes that connects a source to a series of increasingly distant impacts. Novel analytic methods in pursuit of downstream impact attribution were developed and demonstrated on simulations and observations of the 1991 eruption of Mt. Pinatubo in the Philippines.},
  html            = {https://www.osti.gov/biblio/2480139},
  pdf             = {https://www.osti.gov/servlets/purl/2480139},
  bibtex_show     = {true}
}

